{
  "Logging": {
    "LogLevel": {
      "Default":              "Debug",
      "Microsoft.AspNetCore": "Information",
      "FleetStream":          "Debug"
    }
  },
  "Jwt": {
    "Issuer":    "https://auth.fleetstream.example.com",
    "Audience":  "fleetstream-bff",
    "SigningKey": "REPLACE_WITH_DOTNET_USER_SECRETS_OR_ENV_VAR_min_32_chars"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://localhost:3000"
    ]
  },
  "OpenTelemetry": {
    "OtlpEndpoint":      "",
    "PrometheusEnabled": true
  }
}