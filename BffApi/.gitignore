# --- StyleCop / ReSharper / JetBrains ----------------------------------------
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/
*.swp
*.swo

# --- Entity Framework migrations scaffolding (committed) ---------------------
# Keep: src/Infrastructure/**/Migrations/*.cs
# Ignore: local SQLite DB files and EF model snapshots from local dev
*.db
*.db-shm
*.db-wal
*.mdf
*.ldf
*.ndf
*.bak

# --- Secrets & local configuration (NEVER commit) ----------------------------
# User-secrets live outside the repo by default; this catches the rare cases
# where someone sets --project to a path inside the tree.
secrets/
appsettings.*.local.json
appsettings.Local.json
appsettings.*.Production.json
*.pfx
*.p12
*.key
*.pem
!*.crt
!*.cert
.env
.env.*
!.env.example

# --- Swagger / OpenAPI generated clients -------------------------------------
# Ignore client SDKs that CI may generate into /src or /docs
**/Generated/
**/GeneratedClients/
**/openapi/*.json
!**/openapi/openapi.json
!**/openapi/openapi.yaml

# --- Docker ------------------------------------------------------------------
# Local compose overrides and ephemeral container data
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml
.docker/
docker/*.env
docker/.volumes/
docker/data/
*.pid
docker/*.pid

# --- Protobuf / gRPC generated C# ---------------------------------------------
# Generated stubs (if protoc is run locally instead of via the build target)
**/obj/Debug/
**/obj/Release/
**/Protos/Generated/
**/*.pb.cs
!**/*.pb.cc
!**/*.pb.go
!**/*.pb.go.timestamp

# --- Logs & diagnostics ------------------------------------------------------
*.log
*.log.*
[Dd]ebug*/
[Rr]elease*/
LogOutput/

# --- IDEs --------------------------------------------------------------------
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/launch.json.example
.idea/

# --- OS metadata -------------------------------------------------------------
Thumbs.db
.DS_Store
Desktop.ini
