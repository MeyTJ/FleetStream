# =============================================================================
# FleetStream – Repository-level .gitignore
# Applies to the whole monorepo. Per-project .gitignore files (BffApi,
# ingress-gateway, streaming-engine, frontend, tools) contain technology-specific
# rules.
# =============================================================================

# --- Secrets & local configuration (never commit) -----------------------------
.env
.env.*
!.env.example
*.env.local
*.env.*.local
secrets/
*.pfx
*.p12
*.key
*.pem
!*.crt
!*.cert
appsettings.*.local.json
appsettings.Local.json
ops/k8s/secret.yaml
!ops/k8s/secret.yaml.example

# --- Logs & local run artifacts -----------------------------------------------
*.log
logs/
LogOutput/
*.log.*
nohup.out
*.err
*.out
!**/*.out.example

# --- Generated / tool outputs (monorepo-wide) ---------------------------------
outputs/
tools/**/outputs/

# --- Coverage & diagnostic artifacts ------------------------------------------
*.coverage
*.coveragexml
coverage/
*.dtr
*.dsr

# --- OS metadata --------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*

# --- IDEs & editors -----------------------------------------------------------
# Visual Studio / Rider / VS Code
.vs/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
!.vscode/launch.json.example
.idea/
*.user
*.suo
*.sln.docstates
*.userprefs
*.swp
*.swo
*.swn

# --- Build output (root-level; per-project rules cover the rest) --------------
[Bb]in/
[Oo]bj/
out/
dist/
build/
target/
*.dll
*.exe
*.pdb
!*.exe.config

# --- Docker (local overrides only) --------------------------------------------
docker-compose.override.yml
.docker/
docker/.volumes/
docker/data/

# --- Temporary / scratch files ------------------------------------------------
*.tmp
*.bak
*.orig
*.rej
.cache/
.temp/
tmp/
