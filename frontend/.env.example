# FleetStream Frontend Environment Variables
# Copy to .env.local for local development

# BFF API base URL (client-side, exposed to browser)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# SignalR hub URL (client-side, exposed to browser)
NEXT_PUBLIC_SIGNALR_HUB_URL=http://localhost:8080/hubs/v1/fleet

# Content-Security-Policy connect-src override (server-side, build time).
# Leave unset for local development: the CSP is then derived from the two
# variables above. Set it when the browser must reach origins that neither
# NEXT_PUBLIC_* variable names, e.g. a separate websocket edge host:
# CSP_CONNECT_SRC="https://api.fleetstream.example.com wss://ws.fleetstream.example.com"

# Client error-reporting collector (build time, exposed to browser).
# Unset means errors go to the console only. When set, the origin is added to
# CSP connect-src automatically (src/lib/csp.ts), so the two cannot drift:
# reports to a host missing from the policy would be silently blocked.
# NEXT_PUBLIC_ERROR_REPORT_URL=https://errors.fleetstream.example.com/v1/client

# Minimum log level emitted to the console: debug | info | warn | error.
# Unset defaults to "info".
# NEXT_PUBLIC_LOG_LEVEL=debug


