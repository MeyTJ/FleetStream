# Normalise line endings on commit so a Windows checkout cannot produce a
# broken Linux artefact. Without this, a CRLF shell script fails with
# "syntax error near unexpected token `$'do\r''" and a CRLF Dockerfile breaks
# backslash line continuations.
* text=auto

# Must be LF: interpreted/executed by Linux tooling.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile* text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.go text eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Must stay CRLF: Windows-only scripts.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never touch.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.gz binary
*.zip binary
*.snk binary
