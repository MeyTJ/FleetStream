# =============================================================================
# FleetStream.streaming-engine – Go / Kafka / Redis / Prometheus
# Stream processing service.
# =============================================================================

# --- Go build artifacts -------------------------------------------------------
# Binaries built from cmd/ and module-root name
/streaming-engine
/streaming-engine.exe
cmd/*/*.exe
cmd/*/server
cmd/*/worker
cmd/*/processor
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.test
*.prof
*.cover
*.coverprofile
coverage.txt
coverage.html
gocoverage/
coverage/
htmlcov/

# --- Go workspace & vendor ----------------------------------------------------
vendor/
go.work
go.work.sum

# --- Protobuf / gRPC ----------------------------------------------------------
# If/when gRPC contracts are added: commit *.pb.go; ignore gateway/swagger stubs.
**/*.pb.gw.go
**/*.swagger.json

# --- Secrets & local configuration (NEVER commit) -----------------------------
.env
.env.*
!.env.example
*.env.local
config/local.yaml
config/*.local.yaml
configs/local/
configs/*-local.yaml
configs/.local/
secrets/
*.pfx
*.p12
*.key
*.pem
!*.crt
!*.cert

# --- Runtime data & ephemeral state -------------------------------------------
*.pid
*.sock
*.log
*.log.*
logs/
run/
tmp/
data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Docker (local overrides only) --------------------------------------------
Dockerfile.local
docker-compose.override.yml
.docker/
.docker-volumes/

# --- Prometheus / observability local snapshots -------------------------------
metrics-snapshot.*
prometheus-data/

# --- IDEs & editors -----------------------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/launch.json.example
.idea/
*.iml
.fleet/
*.swp
*.swo

# --- OS metadata --------------------------------------------------------------
Thumbs.db
.DS_Store
Desktop.ini
