# --- Go build artifacts -------------------------------------------------------
# Binaries built from cmd/ and module-root name
/ingress-gateway
/ingress-gateway.exe
cmd/server/server
cmd/server/server.exe
cmd/loadtest/loadtest
cmd/loadtest/loadtest.exe
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.test
*.prof
*.cover
*.coverprofile
coverage.txt
coverage.html
gocoverage/
coverage/
htmlcov/

# --- Go workspace & vendor ----------------------------------------------------
vendor/
go.work
go.work.sum

# --- Protobuf / gRPC ----------------------------------------------------------
# Source .proto files and generated *.pb.go ARE committed (CI/Docker build without protoc).
# Ignore optional gateway/swagger stubs only.
proto/gen/v1/*.pb.gw.go
proto/gen/v1/*.swagger.json

# --- Secrets & local configuration (NEVER commit) -----------------------------
.env
.env.*
!.env.example
*.env.local
config/local.yaml
config/*.local.yaml
configs/local/
configs/*-local.yaml
configs/.local/
secrets/
*.pfx
*.p12
*.key
*.pem
!*.crt
!*.cert

# --- Runtime data & ephemeral state -------------------------------------------
*.pid
*.sock
*.log
*.log.*
logs/
run/
tmp/
data/
influxdb/
kafka-data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# --- Docker (local overrides only) --------------------------------------------
Dockerfile.local
docker-compose.override.yml
.docker/
.docker-volumes/

# --- Prometheus / observability local snapshots -------------------------------
metrics-snapshot.*
prometheus-data/

# --- Load test artifacts ------------------------------------------------------
loadtest-results/
loadtest/*.csv
loadtest/*.json
!loadtest/*.json.example
bench.cpu
bench.mem

