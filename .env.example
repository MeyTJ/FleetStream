# FleetStream secrets — copy to .env.production and fill in values.
# Never commit .env.production (see .gitignore).

# --- Redis (required for production profile) ---
REDIS_PASSWORD=change-me-min-32-chars

# --- JWT (BFF production profile) ---
JWT_ISSUER=https://auth.fleetstream.example.com
JWT_AUDIENCE=fleetstream-bff
JWT_JWKS_URI=https://auth.fleetstream.example.com/.well-known/jwks.json

# --- JWT (BFF dev profile only) ---
JWT_SIGNING_KEY=this-is-a-dev-signing-key-at-least-32-chars!!

# --- Kafka TLS (production / managed Kafka) ---
# Set KAFKA_TLS_ENABLED=true when brokers require TLS (e.g. :9093).
KAFKA_TLS_ENABLED=false
KAFKA_CA_CERT_PATH=/etc/fleetstream/certs/kafka-ca.pem
# KAFKA_TLS_INSECURE_SKIP_VERIFY=false

# --- Optional: SASL (managed Kafka) ---
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
