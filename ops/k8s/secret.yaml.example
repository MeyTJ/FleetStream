# Copy to secret.yaml and fill values before applying.
# Do NOT commit secret.yaml.
apiVersion: v1
kind: Secret
metadata:
  name: fleetstream-secrets
  namespace: fleetstream
type: Opaque
stringData:
  redis-password: "REPLACE_ME"
  redis-connection: "redis.fleetstream.svc.cluster.local:6379,password=REPLACE_ME,abortConnect=false"
  jwt-issuer: "https://auth.fleetstream.example.com"
  jwt-jwks-uri: "https://auth.fleetstream.example.com/.well-known/jwks.json"
  kafka-sasl-mechanism: "SCRAM-SHA-512"
  kafka-sasl-username: "REPLACE_ME"
  kafka-sasl-password: "REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: fleetstream-kafka-ca
  namespace: fleetstream
type: Opaque
stringData:
  kafka-ca.pem: |
    -----BEGIN CERTIFICATE-----
    REPLACE_WITH_KAFKA_CA_PEM
    -----END CERTIFICATE-----
